        //     let sonaJan = tokiJan.appendChild(document.createElement('span'));
        //     nimiJan.innerText = janWan.properties.name;
        //     sonaJan.innerText = janWan.properties.description;
        //     return new maplibregl.Popup({offset}).setDOMContent(tokiJan);
        // }
        // sitelenma.on('click', 'jan', (e) => {
        //     const coordinates = e.features[0].geometry.coordinates.slice();

        //     // Ensure that if the map is zoomed out such that multiple
