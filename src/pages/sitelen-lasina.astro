        // });

        for (let {data: janWan} of jan) {
            let tokiJan = document.createElement('div');
            let nimiJan = tokiJan.appendChild(document.createElement('h3'));
            let sonaJan = tokiJan.appendChild(document.createElement('span'));
            nimiJan.innerText = janWan.properties.name;
            sonaJan.innerText = janWan.properties.description;
            new maplibregl.Marker()
                .setLngLat(janWan.geometry.coordinates)
                .setPopup(new maplibregl.Popup().setDOMContent(tokiJan))
                .setOpacity(0.5, 0)
                .addTo(sitelenma);
        }
    });

</script>
